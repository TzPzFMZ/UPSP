{
  "_comment": "定期层装配规则（32轮级刷新，periodic_mounts.json机器源）",
  "_version": "Base-0.10.0",
  "_dds_ref": "§19.5 / §21.1",
  "layer": {
    "frequency": "periodic",
    "refresh": "rhythm_round",
    "cache_hit_rate": "~100%",
    "attention_position": "mid-front (after permanent)"
  },
  "limits": {
    "periodic_memory_items_chars": 65536
  },
  "content": {
    "machine_source": "periodic_mounts.json",
    "includes": [
      "定期记忆投影 (CONTENT)",
      "LTM各层索引 (EXPLORER)",
      "容器索引 (EXPLORER)",
      "关系域索引 (EXPLORER)",
      "场景RULES (RULES)",
      "热度100常驻STM条目 (EXPLORER)",
      "位格层软规范 (RULES)"
    ]
  },
  "trim_policy": "trim_after_popup_and_rules",
  "trim_order": [
    "场景RULES (按trigger匹配度从低到高)",
    "位格层软规范 (behaviors→preferences→social)",
    "索引超出top-N的条目",
    "关系域有焦点标记的条目不裁",
    "热度100常驻STM条目不裁"
  ]
}
