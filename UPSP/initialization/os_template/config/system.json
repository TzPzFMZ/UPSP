{
  "_comment": "系统级基础配置",
  "_version": "Base-0.48.17",
  "_deferred_fields": [
    "identity_timeout",
    "emergency.contact",
    "emergency.local_fallback_model",
    "emergency.physical_alert",
    "health_check.on_boot",
    "health_check.on_standby",
    "health_check.on_rhythm",
    "fatigue.force_sleep_hours",
    "token_usage.critical_ratio"
  ],

  "heartbeat": {
    "interval": 5
  },

  "standby": {
    "idle_threshold_min": 30
  },

  "round": {
    "reminder_seconds": 600,
    "warning_seconds": 1200,
    "auto_relay_seconds": 1800
  },

  "rhythm": {
    "period": 32
  },

  "identity_timeout": 3600,

  "emergency": {
    "contact": null,
    "local_fallback_model": null,
    "physical_alert": false
  },

  "health_check": {
    "on_boot": "active",
    "on_standby": "active",
    "on_rhythm": "full"
  },

  "fatigue": {
    "force_sleep_hours": 0
  },

  "audit": {
    "round_snapshot_retention": 8,
    "round_snapshot_max_mib": 256,
    "round_snapshot_policy_version": 2,
    "state_backup_retention": 8
  },

  "token_usage": {
    "watermark_policy_version": 2,
    "critical_ratio": 0.85,
    "forced_rhythm_on_usage": false,
    "_comment_forced_rhythm": "Base版关闭：单步API无持续上下文积累。Plus/Pro版开启。"
  },

  "response_anchor": {
    "prompt": ""
  },

  "connectivity": {
    "max_latency_records": 32
  },

  "general_tools": {
    "file_read_window_chars": 16384,
    "web_fetch_window_chars": 4096,
    "web_search_window_results": 5
  },

  "execution_permission": {
    "level": "unlimited",
    "_comment": "兼容默认值；GUI 宿主会显式使用 guarded。limited=只读，guarded=受限逐次审批，unlimited=放行。"
  }
}
